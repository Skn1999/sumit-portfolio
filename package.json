{
  "name": "sumit-portfolio-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/labs/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@portfolio/web",
    "dev:portfolio": "turbo run dev --filter=@portfolio/web",
    "dev:all": "turbo run dev",
    "dev:lab": "turbo run dev --filter",
    "dev:silo": "turbo run dev --filter=@labs/silo",
    "build": "turbo run build && node scripts/inject-meta.js",
    "build:agent": "turbo run build && node scripts/inject-meta.js",
    "build:dev": "turbo run build:dev && node scripts/inject-meta.js",
    "build:preview": "VITE_BASE_PATH=/ turbo run build && node scripts/inject-meta.js",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "preview": "npm run build:preview && vite preview --outDir dist",
    "new-lab": "node scripts/create-lab.js",
    "new-project": "node scripts/create-project.js",
    "new-task": "node scripts/create-task.js",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-images:webp": "node scripts/optimize-images.js --webp",
    "optimize-images:dry": "node scripts/optimize-images.js --dry-run",
    "generate-dimensions": "node scripts/generate-image-dimensions.js",
    "assets": "node scripts/optimize-assets.mjs",
    "prebuild": "node scripts/optimize-images.js && node scripts/generate-image-dimensions.js"
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "eslint": "^9.32.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "prompts": "^2.4.2",
    "sharp": "^0.34.5",
    "turbo": "^2.4.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.7"
  }
}
